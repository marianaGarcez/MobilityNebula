[Unit]
Description=MobilityNebula docker-compose stack (SNCB edge)
Documentation=https://github.com/MobilityDB/MobilityNebula
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mobility-nebula
EnvironmentFile=-/etc/mobility-nebula/compose.env
# Force-remove the named containers before compose up so a stale container
# from an earlier (manual `docker run` or older compose) deploy can't hold
# the name "nes-worker" / "query-registration" hostage. Leading "-" makes
# systemd ignore failure when the containers don't yet exist.
ExecStartPre=-/usr/bin/docker rm -f nes-worker query-registration
ExecStart=/usr/bin/docker compose -f docker-compose.runtime.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.runtime.yaml down
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
