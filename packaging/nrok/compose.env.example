# Per-train MobilityNebula configuration. Copy to /etc/mobility-nebula/compose.env
# and edit. The systemd unit loads this via EnvironmentFile; docker compose loads
# the same file via the .env symlink in /opt/mobility-nebula.

# Image to deploy. Built by .github/workflows/nrok_release.yml on every push.
# Pin to an immutable tag (sha-<7> or a version) for production rollouts; the
# branch tag below is convenient for testing but moves on every push.
NES_RUNTIME_IMAGE=ghcr.io/marianagarcez/mobility-nebula:feature-upstream-update-tcp-reconnect

# Worker thread count. Tune per nrok hardware.
NES_WORKER_THREADS=2

# Which query yaml (under /opt/mobility-nebula/Queries) to register on start.
NES_QUERY_FILE=sncb_brake_monitoring.yaml
