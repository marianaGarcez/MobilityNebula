# Per-train MobilityNebula configuration. Copy to /etc/mobility-nebula/compose.env
# and edit. The systemd unit loads this via EnvironmentFile; docker compose loads
# the same file via the .env symlink in /opt/mobility-nebula.

# Image to deploy. PIN BY DIGEST for production rollouts so every nrok runs
# the same byte-for-byte image even if a branch tag later moves or CI breaks.
# The digest below points at the last known-good build (commit 653441a6dc,
# MQTTSink working end-to-end). Update only after a new image is verified.
NES_RUNTIME_IMAGE=ghcr.io/marianagarcez/mobility-nebula@sha256:8f6a29903827bdd1ebc5af14e4753751dae2c7c3e790228b1ac74a4ff6ad89a7

# Worker thread count. Tune per nrok hardware.
NES_WORKER_THREADS=2

# Which query yaml (under /opt/mobility-nebula/Queries) to register on start.
NES_QUERY_FILE=sncb_brake_monitoring.yaml
