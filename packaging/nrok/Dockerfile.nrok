# syntax=docker/dockerfile:1
# Multi-stage build for NROK-1030 railway gateway (x86_64 Intel Atom)
# and Apple Silicon MacBooks (ARM64)
#
# The upstream nebulastream/nes-development image does not include MEOS
# or paho-mqtt, so we install them before building.
ARG TAG=latest
ARG BUILD_TYPE=RelWithDebInfo
FROM nebulastream/nes-development:${TAG} AS build

USER root

# ── Install MEOS (MobilityDB) and its dependencies ──────────────────
RUN apt-get update -y && apt-get install -y --no-install-recommends \
        postgresql-server-dev-all \
        postgresql-common \
        postgresql-client \
        postgis \
        libproj-dev \
        libjson-c-dev \
        libgsl-dev \
        libgeos-dev \
        libgeos++-dev \
        libxml2-dev \
        gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/MobilityDB/MobilityDB.git -b master /tmp/MobilityDB \
    && mkdir -p /tmp/MobilityDB/build \
    && cd /tmp/MobilityDB/build \
    && cmake -G "Unix Makefiles" \
             -DMEOS=ON -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ .. \
    && cmake --build . -j$(nproc) \
    && cmake --install . \
    && ldconfig \
    && rm -rf /tmp/MobilityDB

# ── Install paho-mqtt via vcpkg in classic mode (missing from upstream SDK) ──
COPY vcpkg/custom-triplets /tmp/vcpkg_overlay/custom-triplets
COPY vcpkg/vcpkg-registry/ports /tmp/vcpkg_overlay/ports
RUN set -eux; \
    cd /tmp; \
    git clone --depth 1 https://github.com/microsoft/vcpkg.git vcpkg_classic; \
    ./vcpkg_classic/bootstrap-vcpkg.sh --disableMetrics; \
    ARCH=$(dpkg --print-architecture | sed 's/amd64/x64/'); \
    ./vcpkg_classic/vcpkg install \
        paho-mqtt paho-mqttpp3[ssl] \
        --overlay-triplets=/tmp/vcpkg_overlay/custom-triplets \
        --overlay-ports=/tmp/vcpkg_overlay/ports \
        --triplet="${ARCH}-linux-none-libcxx"; \
    cp -a /tmp/vcpkg_classic/installed/* /vcpkg/installed/; \
    rm -rf /tmp/vcpkg_classic /tmp/vcpkg_overlay

# ── Build MobilityNebula ─────────────────────────────────────────────
ADD . /home/ubuntu/src
RUN --mount=type=cache,id=ccache,target=/ccache \
    export CCACHE_DIR=/ccache && \
    cd /home/ubuntu/src && \
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
        -DNES_ENABLES_TESTS=0 && \
    cmake --build build --target nes-single-node-worker nes-cli -j && \
    mkdir -p /tmp/bin /tmp/lib /tmp/queries && \
    find build -name 'nes-single-node-worker' -type f -exec cp {} /tmp/bin/ \; && \
    find build -name 'nes-cli' -type f -exec cp {} /tmp/bin/ \; && \
    cp -r Queries/* /tmp/queries/ 2>/dev/null || true

# Collect shared library dependencies needed at runtime
RUN for bin in /tmp/bin/*; do \
        ldd "$bin" 2>/dev/null | grep '=>' | awk '{print $3}' | \
        while read lib; do \
            [ -f "$lib" ] && cp -L "$lib" /tmp/lib/ 2>/dev/null || true; \
        done; \
    done

# ── Stage 2: Lean runtime image ─────────────────────────────────────
FROM ubuntu:24.04 AS runtime
LABEL org.opencontainers.image.title="MobilityNebula NROK Gateway"
LABEL org.opencontainers.image.description="Stream processing engine for NROK-1030 railway gateway"
LABEL org.opencontainers.image.source="https://github.com/MobilityDB/MobilityNebula"

ENV LLVM_TOOLCHAIN_VERSION=19
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        curl wget gpg ca-certificates && \
    curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | \
        gpg --dearmor -o /etc/apt/keyrings/llvm-snapshot.gpg && \
    chmod a+r /etc/apt/keyrings/llvm-snapshot.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/llvm-snapshot.gpg] \
        http://apt.llvm.org/$(. /etc/os-release && echo "$VERSION_CODENAME")/ \
        llvm-toolchain-$(. /etc/os-release && echo "$VERSION_CODENAME")-${LLVM_TOOLCHAIN_VERSION} main" \
        > /etc/apt/sources.list.d/llvm-snapshot.list && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends \
        libc++1-${LLVM_TOOLCHAIN_VERSION} \
        libc++abi1-${LLVM_TOOLCHAIN_VERSION} \
        tzdata && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN GRPC_HEALTH_PROBE_VERSION=v0.4.40 && \
    wget -qO /bin/grpc_health_probe \
        "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-$(dpkg --print-architecture)" && \
    chmod +x /bin/grpc_health_probe

COPY --from=build /tmp/bin/* /usr/local/bin/
COPY --from=build /tmp/lib/* /usr/local/lib/
COPY --from=build /tmp/queries /opt/mobility-nebula/Queries
RUN ldconfig

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD grpc_health_probe -addr=:8080 || exit 1

ENTRYPOINT ["nes-single-node-worker"]
