# name: function/spatiotemporal/MEOS_Intersects_Multiple.test
# description: Test for multiple TEMPORALINTERSECTS operations
# groups: [Function, MEOS, SpatioTemporal]

# Test 1: Single point matching hardcoded reference (-73.9857, 40.7484)
CREATE LOGICAL SOURCE locations(id UINT32, longitude FLOAT64, latitude FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR locations TYPE File;
ATTACH INLINE
1,-73.9857,40.7484,1609459200
2,-73.9867,40.7494,1609459210
3,-73.9800,40.7450,1609459220
4,-73.9857,40.7484,1609459230

CREATE SINK basic_results(locations.id UINT32, intersects BOOLEAN NOT NULL) TYPE File;

SELECT id, TEMPORALINTERSECTS(longitude, latitude, timestamp) AS intersects
FROM locations
INTO basic_results;
----
1,1
2,0
3,0
4,1
