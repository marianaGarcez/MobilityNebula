# name: function/spatiotemporal/MEOS_Intersects_Simple.test
# description: Simple test for TemporalIntersects function
# groups: [Function, MEOS, SpatioTemporal]

# Test 1: Basic temporal intersects with a single point matching hardcoded reference
CREATE LOGICAL SOURCE locations(id UINT32, longitude FLOAT64, latitude FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR locations TYPE File;
ATTACH INLINE
1,-73.9857,40.7484,1609459200

CREATE SINK result(locations.id UINT32, intersects BOOLEAN NOT NULL) TYPE File;

SELECT id, TEMPORALINTERSECTS(longitude, latitude, timestamp) AS intersects
FROM locations
INTO result;
----
1,1
